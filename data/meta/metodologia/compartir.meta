Fase 3: Compartir




Visión General

Compartir es la fase donde el conocimiento validado es distribuido efectivamente a las personas correctas, en el momento correcto y en el contexto correcto. El objetivo es maximizar el descubrimiento y acceso al conocimiento relevante.";}s:8:"relation";a:3:{s:5:"media";a:2:{s:16:"anchor:compartir";b:0;s:22:"metodologia:meca_share";b:0;}s:10:"references";a:7:{s:29:"metodologia:knowledge-digests";b:0;s:29:"metodologia:slack-integration";b:0;s:30:"metodologia:personalized-feeds";b:0;s:25:"metodologia:mobile-alerts";b:0;s:27:"metodologia:semantic-search";b:0;s:31:"metodologia:chatbot-integration";b:0;s:26:"metodologia:learning-paths";b:0;}s:10:"firstimage";s:0:"";}s:8:"internal";a:2:{s:5:"cache";b:1;s:3:"toc";b:1;}}s:10:"persistent";a:4:{s:4:"date";a:1:{s:7:"created";i:1762629789;}s:11:"last_change";a:9:{s:4:"date";i:1762629789;s:2:"ip";s:3:"::1";s:4:"type";s:1:"C";s:2:"id";s:21:"metodologia:compartir";s:4:"user";s:0:"";s:3:"sum";s:6:"creado";s:5:"extra";s:0:"";s:10:"sizechange";i:3006;s:4:"mode";s:4:"page";}s:4:"user";s:0:"";s:7:"creator";s:0:"";}}